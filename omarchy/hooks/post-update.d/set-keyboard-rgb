#!/bin/bash
# Re-apply keyboard RGB after an Omarchy update (acpi_call may have been rebuilt).

HELPER=""
if [[ -x /usr/local/bin/omen-kbd-rgb ]]; then
  HELPER=/usr/local/bin/omen-kbd-rgb
elif [[ -x $HOME/.local/share/omarchy/omen-kbd-rgb/omen-kbd-rgb ]]; then
  HELPER=$HOME/.local/share/omarchy/omen-kbd-rgb/omen-kbd-rgb
fi

[[ -n $HELPER ]] || exit 0

if [[ -w /proc/acpi/call || -d /sys/devices/platform/omen-rgb-keyboard || -d /sys/devices/platform/hp-wmi/rgb_zones ]]; then
  "$HELPER" theme >/dev/null
else
  sudo -n "$HELPER" theme >/dev/null || true
fi
